# frontend/Dockerfile.prod — production frontend.           marker: patch_prod_compose
#
# Stage 1 protocol-builder : build @verisphere/protocol dist (same as dev).
# Stage 2 frontend-builder : `vite build` with VITE_* baked in at BUILD time.
#                            FAILS LOUD if VITE_WALLETCONNECT_PROJECT_ID is empty
#                            or the dead 'fallback-local-id' sentinel — the prod
#                            analogue of the smoke-harness wiring check (Vite
#                            inlines import.meta.env at build time, so this is the
#                            only place to catch a broken projectId before it ships).
# Stage 3 caddy            : serve the static dist + reverse-proxy /api + TLS + CSP,
#                            and the landing page (www/ checkout -> /srv/landing;
#                            Caddyfile serves it at the apex, the SPA at app.<site>).

# -- Stage 1: protocol -------------------------------------------------------
FROM node:20-slim AS protocol-builder
WORKDIR /protocol
COPY core/out ../core/out
COPY protocol/package*.json ./
RUN npm install
COPY protocol/src ./src
COPY protocol/script ./script
COPY protocol/tsconfig.json ./
RUN npm run build
# evict the SDK's dev-pinned wagmi/react after building: the frontend supplies them
# (Vite dedupe enforces a single copy either way; this keeps the image honest)
RUN rm -rf node_modules/wagmi node_modules/@wagmi node_modules/react node_modules/react-dom

# -- Stage 2: static SPA build -----------------------------------------------
FROM node:20-slim AS frontend-builder
WORKDIR /frontend
COPY --from=protocol-builder /protocol /protocol
ENV PROTOCOL_PATH=/protocol
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps
COPY frontend/ .

# VITE_* are baked into the static bundle (NOT runtime env in prod).
ARG VITE_API_BASE=/api
ARG VITE_CHAIN_ENV
ARG VITE_WALLETCONNECT_PROJECT_ID

# Loud build-time wiring assertions (prod equivalent of vsp-smoke's checks).
RUN set -e; \
    if [ -z "$VITE_WALLETCONNECT_PROJECT_ID" ] || [ "$VITE_WALLETCONNECT_PROJECT_ID" = "fallback-local-id" ]; then \
      echo "FATAL(prod build): VITE_WALLETCONNECT_PROJECT_ID is empty or the 'fallback-local-id' sentinel." >&2; \
      echo "  Pass it from the resolved env at build time, e.g.:" >&2; \
      echo "    docker compose --env-file /dev/shm/vsp-resolved.env -f docker-compose.prod.yml build caddy" >&2; \
      exit 1; \
    fi; \
    if [ -z "$VITE_CHAIN_ENV" ]; then \
      echo "FATAL(prod build): VITE_CHAIN_ENV is empty (code would default to 'fuji' — a mainnet footgun)." >&2; exit 1; \
    fi

ENV VITE_API_BASE=$VITE_API_BASE \
    VITE_CHAIN_ENV=$VITE_CHAIN_ENV \
    VITE_WALLETCONNECT_PROJECT_ID=$VITE_WALLETCONNECT_PROJECT_ID
RUN npm run build
# NOTE: VITE_USDC_ADDRESS is intentionally NOT a build arg — tokenAddresses.ts has
# a safe hardwired per-chain default (Fuji 0x5425..Bc65 / mainnet 0xB97E..a6E).

# -- Stage 3: Caddy edge -----------------------------------------------------
FROM caddy:2-alpine
COPY --from=frontend-builder /frontend/dist /srv
# patch_edge_landing_apphost: the landing page is the www checkout at the repo root
# (gitignored there; a sibling clone of VerisphereVSP/www). The root .dockerignore
# strips its .git. CNAME is GitHub-Pages metadata and must not be served. A missing
# www/ fails this COPY loudly — clone it before building (ROLLOUT-CHECKLIST).
COPY www/ /srv/landing/
RUN rm -f /srv/landing/CNAME && test -s /srv/landing/index.html && ! test -e /srv/landing/.git
COPY ops/caddy/Caddyfile /etc/caddy/Caddyfile
# Fail the build, not the rollout, on a Caddyfile Caddy would refuse at start.
# Env-dependent pieces take the staging defaults here; prod validates again with
# its own env before `up -d` (PROD-EDGE-ROLLOUT). Validation under local_certs mints
# a throwaway internal CA, so it runs against a scratch dir removed in the same layer:
# no key material is baked into the image.
RUN set -e; XDG_DATA_HOME=/tmp/cv XDG_CONFIG_HOME=/tmp/cv VSP_CADDY_GLOBAL=local_certs \
      caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile; \
    rm -rf /tmp/cv; ! test -e /data/caddy/pki
EXPOSE 80 443
# caddy:2-alpine default entrypoint: caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
